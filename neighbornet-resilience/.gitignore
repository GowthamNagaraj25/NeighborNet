# Dependencies — never commit these
node_modules/
*/node_modules/

# Environment files — never commit real secrets
.env
server/.env
client/.env
client/.env.production

# Build output
client/dist/
client/build/

# Logs
*.log
npm-debug.log*
yarn-debug.log*

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Editor
.vscode/
.idea/
*.swp
*.swo
